enum OperatorType {
  DRIVER
  DISPATCHER
  HOSPITAL_STAFF
}

model OperatorProfile {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  operatorType  OperatorType @map("operator_type")
  licenseNumber String?      @map("license_number") @db.VarChar(100)
  employeeCode  String?      @map("employee_code") @db.VarChar(100)
  hospitalId    String?      @map("hospital_id") @db.Uuid
  isAvailable   Boolean      @default(false) @map("is_available")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  dispatchAssignments DispatchAssignment[] @relation("DriverAssignments")
  trips               Trip[]               @relation("DriverTrips")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([operatorType])
  @@index([hospitalId])
  @@map("operator_profiles")
}
